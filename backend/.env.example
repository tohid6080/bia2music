# کپی کنید: cp .env.example .env   سپس مقدارها را پر کنید. فایل .env را هرگز در Git یا چت نگذارید.

# development | production
APP_ENV=development

# توکن ربات از @BotFather (محرمانه)
BOT_TOKEN=

# شناسه‌ی عددی تلگرام مدیر (فقط همین کاربر مدیر است)
ADMIN_USER_ID=

# کانال مقصد انتشار (مرحله‌های بعد)
CHANNEL_ID=@bia2music1395

# آدرس HTTPS عمومی مینی‌اپ (بدون / در انتها). تلگرام آدرس غیر HTTPS را نمی‌پذیرد.
WEBAPP_URL=

# کلید امضای نشست‌ها: حداقل ۳۲ نویسه‌ی تصادفی. ساخت:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# در production الزامی است؛ در development خالی بماند یعنی کلید موقت ساخته می‌شود.
JWT_SECRET=

# دیتابیس. پیش‌فرض: SQLite در backend/data/bia2music.db  —  برای PostgreSQL: postgresql://user:pass@host:5432/db
DATABASE_URL=

# اختیاری
DEFAULT_LANGUAGE=fa
JWT_TTL_MINUTES=720
INITDATA_MAX_AGE_SECONDS=86400
AUTH_RATE_PER_MINUTE=20
API_RATE_PER_MINUTE=240
# فقط پشت پراکسی/تونل قابل‌اعتماد (Cloudflare و…) روشن کنید تا IP واقعی برای محدودیت نرخ خوانده شود
TRUST_PROXY_HEADERS=0
# اگر فرانت‌اند را جدا میزبانی می‌کنید: دامنه‌ها با کاما
CORS_ORIGINS=
# سرو فایل‌های ساخته‌شده‌ی مینی‌اپ توسط خود Backend (ساده‌ترین استقرار: یک آدرس HTTPS)
SERVE_WEBAPP=1
