# --- الزامی ---
# توکن ربات از BotFather (هرگز آن را جایی منتشر نکنید)
TELEGRAM_BOT_TOKEN=
# شناسه عددی تلگرام مدیر اصلی (از ربات @userinfobot بگیرید)
ADMIN_USER_ID=
# --- کانال ---
# @username کانال یا شناسه عددی (مثل -1001234567890). قابل تغییر از داخل ربات.
CHANNEL_ID=@bia2music1395
# --- عمومی ---
DATABASE_PATH=data/musicbot.sqlite3
LOG_LEVEL=INFO
TIMEZONE=Asia/Tehran
# --- هوش مصنوعی (اختیاری؛ خالی = بدون AI واقعی، بدون هزینه) ---
# مقدار مجاز: none | claude   (openai هنوز پیاده‌سازی نشده)
AI_PROVIDER=none
# اختیاری. پیش‌فرض claude-opus-5-5 است. ارزان‌تر: claude-haiku-5-5 (حدود ۴۰ برابر ارزان‌تر) یا claude-sonnet-5-5
AI_MODEL=
# کلید را فقط اینجا بگذارید (نه در چت و نه در کد)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- رادار موسیقی ترند (کلیدهای رایگان؛ اختیاری) ---
# YouTube Data API v3 (کلید رایگان گوگل، بدون صورتحساب) و Last.fm (کلید رایگان). فقط در همین فایل بگذارید.
YOUTUBE_API_KEY=
LASTFM_API_KEY=
